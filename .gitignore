# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
apps/web/dist/
apps/web/.angular/
apps/api/dist/
# built Angular static assets, copied into apps/api/public at build time
apps/api/public/*
!apps/api/public/.gitkeep

# release assembly (release.yml)
/release/
review-grader-windows.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local database (each host machine keeps its own scoring data)
/data/

# typescript
*.tsbuildinfo
