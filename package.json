{
  "name": "review-grader",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@review-grader/api",
    "dev:web": "npm run start --workspace=web",
    "build": "npm run build --workspace=@review-grader/api && npm run build --workspace=web && npm run copy:web-static",
    "copy:web-static": "node -e \"const fs=require('fs');fs.rmSync('apps/api/public',{recursive:true,force:true});fs.cpSync('apps/web/dist/web/browser','apps/api/public',{recursive:true});\"",
    "start": "npm run start --workspace=@review-grader/api",
    "lint": "npm run lint --workspace=@review-grader/api"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
